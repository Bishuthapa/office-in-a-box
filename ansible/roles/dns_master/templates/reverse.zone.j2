; Reverse zone 0.10.10.in-addr.arpa — IP -> name (PTR)
$TTL 3600
@   IN SOA dns01.{{ lab_domain }}. admin.{{ lab_domain }}. (
        {{ zone_serial }} 3600 900 604800 300 )

    IN NS   dns01.{{ lab_domain }}.
    IN NS   dns02.{{ lab_domain }}.

{% for host, ip in lab_hosts.items() %}
{{ ip.split('.')[-1] }}    IN PTR  {{ host }}.{{ lab_domain }}.
{% endfor %}
